# Reproducible Linux build: Python 3.12 on Debian bookworm (glibc 2.36), so the binary runs on most current distros.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends binutils libgl1 libegl1 libxkbcommon0 \
      libfontconfig1 libdbus-1-3 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/
COPY packaging/ ./packaging/
RUN pip install --no-cache-dir . -r packaging/requirements-build.txt
RUN bash packaging/build.sh && QT_QPA_PLATFORM=offscreen ./dist/samlscope --smoke-test
